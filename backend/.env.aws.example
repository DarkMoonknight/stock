# AWS runtime configuration (do not commit real secrets)
NODE_ENV=production
AWS_REGION=ap-south-1
AWS_SECRETS_MANAGER_SECRET_ID=ezyprocure/production/app
AWS_SECRETS_OVERRIDE=true
AWS_RDS_SSL=true

# Non-secret application configuration
FRONTEND_URL=https://vaquitecalifornia.com,https://www.vaquitecalifornia.com
JWT_EXPIRES_IN=12h

# When AWS_SECRETS_MANAGER_SECRET_ID is set, keep these sensitive values in
# AWS Secrets Manager instead of this file. Recommended JSON keys:
# DATABASE_URL
# JWT_SECRET
# DEMO_ADMIN_EMAIL
# DEMO_ADMIN_PASSWORD
# OPENAI_API_KEY
