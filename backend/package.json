{
  "name": "ezyprocure-backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/advanced-server.js",
    "start": "prisma generate && perl -0pi -e \"s#https://vaqutecalifornia\\.com#https://vaqutecalifornia.com','https://vaquitecalifornia.com#g\" src/advanced-server.js && node src/advanced-server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:validate": "prisma validate",
    "seed": "node prisma/seed.mjs",
    "test:contract": "node tests/api-contract.test.mjs",
    "test:admin-control": "node tests/admin-control.contract.test.mjs",
    "test:all": "npm run prisma:validate && npm run test:contract && npm run test:admin-control"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "prisma": "^6.14.0"
  },
  "engines": {"node": ">=20 <25"}
}
