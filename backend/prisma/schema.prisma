generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROCUREMENT
  SITE_STORE
  SITE_ENGINEER
  ACCOUNTS
  HR
  MANAGEMENT
}

enum Status {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SENT
  PARTIAL
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEK_OFF
}

enum PaymentMethod {
  BANK
  CASH
  UPI
  CHEQUE
  OTHER
}

model Company {
  id String @id @default(cuid())
  name String
  gstin String? @unique
  countryCode String @default("IN")
  baseCurrency String @default("INR")
  timezone String @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  departments Department[]
  sites Site[]
  siteTasks SiteTask[]
  users User[]
  employees Employee[]
  labourers Labour[]
  vendors Vendor[]
  materials Material[]
  prs PurchaseRequisition[]
  rfqs RFQ[]
  pos PurchaseOrder[]
  grns GRN[]
  mrns MRN[]
  invoices Invoice[]
  expenses Expense[]
  payments Payment[]
  auditLogs AuditLog[]
  @@index([name])
}

model Department {
  id String @id @default(cuid())
  companyId String
  code String
  name String
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users User[]
  employees Employee[]
  @@unique([companyId, code])
  @@index([companyId, active])
}

model User {
  id String @id @default(cuid())
  companyId String
  departmentId String?
  name String
  email String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approvals Approval[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  @@index([companyId, role, active])
}

model Employee {
  id String @id @default(cuid())
  companyId String
  departmentId String?
  employeeCode String
  name String
  email String?
  phone String?
  designation String?
  joiningDate DateTime?
  employmentType String @default("FULL_TIME")
  salary Decimal? @db.Decimal(18, 2)
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendances EmployeeAttendance[]
  @@unique([companyId, employeeCode])
  @@index([companyId, active])
}

model Labour {
  id String @id @default(cuid())
  companyId String
  labourCode String
  name String
  trade String?
  contractor String?
  phone String?
  dailyRate Decimal? @db.Decimal(18, 2)
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendances LabourAttendance[]
  @@unique([companyId, labourCode])
  @@index([companyId, active])
}

model Site {
  id String @id @default(cuid())
  companyId String
  code String
  name String
  location String?
  manager String?
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prs PurchaseRequisition[]
  pos PurchaseOrder[]
  grns GRN[]
  mrns MRN[]
  stock Stock[]
  tasks SiteTask[]
  labourAttendances LabourAttendance[]
  expenses Expense[]
  @@unique([companyId, code])
  @@index([companyId, active])
}

model SiteTask {
  id String @id @default(cuid())
  companyId String
  siteId String
  title String
  description String?
  assignedTo String?
  status Status @default(PENDING)
  priority String @default("NORMAL")
  dueDate DateTime?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@index([companyId, siteId, status])
}

model Material {
  id String @id @default(cuid())
  companyId String
  code String
  name String
  category String
  unit String
  hsn String?
  gstRate Decimal? @db.Decimal(5, 2)
  reorderLevel Decimal? @db.Decimal(18, 3)
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prItems PRItem[]
  quoteItems QuoteItem[]
  poItems POItem[]
  grnItems GRNItem[]
  mrnItems MRNItem[]
  stock Stock[]
  @@unique([companyId, code])
}

model Vendor {
  id String @id @default(cuid())
  companyId String
  name String
  gstin String?
  pan String?
  countryCode String @default("IN")
  currencyCode String @default("INR")
  phone String?
  email String?
  creditLimit Decimal? @db.Decimal(18, 2)
  paymentDays Int @default(0)
  rating Decimal? @db.Decimal(3, 2)
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rfqs RFQVendor[]
  quotes Quote[]
  pos PurchaseOrder[]
  invoices Invoice[]
  payments Payment[]
}

model PurchaseRequisition {
  id String @id @default(cuid())
  companyId String
  siteId String
  number String @unique
  requestedBy String
  requiredDate DateTime
  status Status @default(DRAFT)
  notes String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id])
  items PRItem[]
  rfqs RFQ[]
  createdAt DateTime @default(now())
}

model PRItem {
  id String @id @default(cuid())
  prId String
  materialId String
  quantity Decimal @db.Decimal(18, 3)
  estimatedRate Decimal? @db.Decimal(18, 2)
  pr PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model RFQ {
  id String @id @default(cuid())
  companyId String
  prId String
  number String @unique
  dueDate DateTime
  status Status @default(DRAFT)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pr PurchaseRequisition @relation(fields: [prId], references: [id])
  vendors RFQVendor[]
  quotes Quote[]
}

model RFQVendor {
  id String @id @default(cuid())
  rfqId String
  vendorId String
  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])
  @@unique([rfqId, vendorId])
}

model Quote {
  id String @id @default(cuid())
  rfqId String
  vendorId String
  quoteNo String?
  currencyCode String @default("INR")
  exchangeRate Decimal? @db.Decimal(18, 8)
  freight Decimal? @db.Decimal(18, 2)
  tax Decimal? @db.Decimal(18, 2)
  validUntil DateTime?
  total Decimal @db.Decimal(18, 2)
  recommended Boolean @default(false)
  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])
  items QuoteItem[]
}

model QuoteItem {
  id String @id @default(cuid())
  quoteId String
  materialId String
  quantity Decimal @db.Decimal(18, 3)
  unitRate Decimal @db.Decimal(18, 2)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model Approval {
  id String @id @default(cuid())
  entityType String
  entityId String
  userId String
  status ApprovalStatus @default(PENDING)
  comment String?
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
}

model PurchaseOrder {
  id String @id @default(cuid())
  companyId String
  siteId String
  vendorId String
  prId String?
  number String @unique
  orderDate DateTime @default(now())
  status Status @default(DRAFT)
  currencyCode String @default("INR")
  exchangeRate Decimal? @db.Decimal(18, 8)
  subtotal Decimal @db.Decimal(18, 2)
  tax Decimal @db.Decimal(18, 2)
  total Decimal @db.Decimal(18, 2)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])
  items POItem[]
  grns GRN[]
  invoices Invoice[]
}

model POItem {
  id String @id @default(cuid())
  poId String
  materialId String
  orderedQty Decimal @db.Decimal(18, 3)
  receivedQty Decimal @default(0) @db.Decimal(18, 3)
  rate Decimal @db.Decimal(18, 2)
  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model GRN {
  id String @id @default(cuid())
  companyId String
  siteId String
  poId String
  number String @unique
  receivedAt DateTime @default(now())
  status Status @default(DRAFT)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id])
  po PurchaseOrder @relation(fields: [poId], references: [id])
  items GRNItem[]
}

model GRNItem {
  id String @id @default(cuid())
  grnId String
  materialId String
  receivedQty Decimal @db.Decimal(18, 3)
  rejectedQty Decimal @default(0) @db.Decimal(18, 3)
  grn GRN @relation(fields: [grnId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model MRN {
  id String @id @default(cuid())
  companyId String
  siteId String
  number String @unique
  requestedBy String
  requiredDate DateTime
  status Status @default(PENDING)
  purpose String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id])
  items MRNItem[]
  createdAt DateTime @default(now())
  @@index([companyId, siteId, status])
}

model MRNItem {
  id String @id @default(cuid())
  mrnId String
  materialId String
  quantity Decimal @db.Decimal(18, 3)
  issuedQty Decimal @default(0) @db.Decimal(18, 3)
  mrn MRN @relation(fields: [mrnId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model Stock {
  id String @id @default(cuid())
  siteId String
  materialId String
  quantity Decimal @default(0) @db.Decimal(18, 3)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
  @@unique([siteId, materialId])
}

model EmployeeAttendance {
  id String @id @default(cuid())
  employeeId String
  date DateTime
  status AttendanceStatus
  inTime DateTime?
  outTime DateTime?
  remarks String?
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, date])
}

model LabourAttendance {
  id String @id @default(cuid())
  labourId String
  siteId String
  date DateTime
  status AttendanceStatus
  units Decimal? @db.Decimal(18, 2)
  overtimeHours Decimal? @db.Decimal(8, 2)
  remarks String?
  labour Labour @relation(fields: [labourId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@unique([labourId, siteId, date])
  @@index([siteId, date])
}

model Invoice {
  id String @id @default(cuid())
  companyId String
  vendorId String
  poId String?
  number String
  invoiceDate DateTime
  dueDate DateTime?
  currencyCode String @default("INR")
  exchangeRate Decimal? @db.Decimal(18, 8)
  amount Decimal @db.Decimal(18, 2)
  paidAmount Decimal @default(0) @db.Decimal(18, 2)
  status Status @default(PENDING)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])
  po PurchaseOrder? @relation(fields: [poId], references: [id])
  payments Payment[]
  @@unique([vendorId, number])
}

model Expense {
  id String @id @default(cuid())
  companyId String
  siteId String?
  category String
  description String
  amount Decimal @db.Decimal(18, 2)
  expenseDate DateTime
  status Status @default(PENDING)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id])
  @@index([companyId, expenseDate])
}

model Payment {
  id String @id @default(cuid())
  companyId String
  vendorId String?
  invoiceId String?
  amount Decimal @db.Decimal(18, 2)
  method PaymentMethod
  reference String?
  paidAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  @@index([companyId, paidAt])
}

model AuditLog {
  id String @id @default(cuid())
  companyId String
  userId String?
  action String
  entityType String
  entityId String?
  beforeJson String?
  afterJson String?
  ipAddress String?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}
