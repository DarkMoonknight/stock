generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN PROCUREMENT SITE_STORE ACCOUNTS MANAGEMENT }
enum Status { DRAFT PENDING APPROVED REJECTED SENT PARTIAL CLOSED CANCELLED }
enum ApprovalStatus { PENDING APPROVED REJECTED }

model Company { id String @id @default(cuid()); name String; gstin String? @unique; createdAt DateTime @default(now()); sites Site[]; users User[]; vendors Vendor[]; materials Material[]; prs PurchaseRequisition[]; rfqs RFQ[]; pos PurchaseOrder[]; grns GRN[]; invoices Invoice[]; @@index([name]) }
model User { id String @id @default(cuid()); companyId String; name String; email String @unique; passwordHash String; role Role; active Boolean @default(true); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); approvals Approval[]; createdAt DateTime @default(now()); }
model Site { id String @id @default(cuid()); companyId String; code String; name String; location String?; manager String?; active Boolean @default(true); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); prs PurchaseRequisition[]; pos PurchaseOrder[]; grns GRN[]; stock Stock[]; @@unique([companyId, code]) }
model Material { id String @id @default(cuid()); companyId String; code String; name String; category String; unit String; hsn String?; gstRate Decimal? @db.Decimal(5,2); reorderLevel Decimal? @db.Decimal(18,3); active Boolean @default(true); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); prItems PRItem[]; quoteItems QuoteItem[]; poItems POItem[]; stock Stock[]; @@unique([companyId, code]) }
model Vendor { id String @id @default(cuid()); companyId String; name String; gstin String?; pan String?; phone String?; email String?; creditLimit Decimal? @db.Decimal(18,2); paymentDays Int @default(0); rating Decimal? @db.Decimal(3,2); active Boolean @default(true); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); rfqs RFQVendor[]; quotes Quote[]; pos PurchaseOrder[]; invoices Invoice[]; }
model PurchaseRequisition { id String @id @default(cuid()); companyId String; siteId String; number String @unique; requestedBy String; requiredDate DateTime; status Status @default(DRAFT); notes String?; company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); site Site @relation(fields:[siteId], references:[id]); items PRItem[]; rfqs RFQ[]; approvals Approval[]; createdAt DateTime @default(now()); }
model PRItem { id String @id @default(cuid()); prId String; materialId String; quantity Decimal @db.Decimal(18,3); estimatedRate Decimal? @db.Decimal(18,2); pr PurchaseRequisition @relation(fields:[prId], references:[id], onDelete:Cascade); material Material @relation(fields:[materialId], references:[id]); }
model RFQ { id String @id @default(cuid()); companyId String; prId String; number String @unique; dueDate DateTime; status Status @default(DRAFT); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); pr PurchaseRequisition @relation(fields:[prId], references:[id]); vendors RFQVendor[]; quotes Quote[]; }
model RFQVendor { id String @id @default(cuid()); rfqId String; vendorId String; rfq RFQ @relation(fields:[rfqId], references:[id], onDelete:Cascade); vendor Vendor @relation(fields:[vendorId], references:[id]); @@unique([rfqId, vendorId]) }
model Quote { id String @id @default(cuid()); rfqId String; vendorId String; quoteNo String?; freight Decimal? @db.Decimal(18,2); tax Decimal? @db.Decimal(18,2); validUntil DateTime?; total Decimal @db.Decimal(18,2); recommended Boolean @default(false); rfq RFQ @relation(fields:[rfqId], references:[id], onDelete:Cascade); vendor Vendor @relation(fields:[vendorId], references:[id]); items QuoteItem[]; }
model QuoteItem { id String @id @default(cuid()); quoteId String; materialId String; quantity Decimal @db.Decimal(18,3); unitRate Decimal @db.Decimal(18,2); quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade); material Material @relation(fields:[materialId], references:[id]); }
model Approval { id String @id @default(cuid()); entityType String; entityId String; userId String; status ApprovalStatus @default(PENDING); comment String?; user User @relation(fields:[userId], references:[id]); createdAt DateTime @default(now()); @@index([entityType, entityId]) }
model PurchaseOrder { id String @id @default(cuid()); companyId String; siteId String; vendorId String; prId String?; number String @unique; orderDate DateTime @default(now()); status Status @default(DRAFT); subtotal Decimal @db.Decimal(18,2); tax Decimal @db.Decimal(18,2); total Decimal @db.Decimal(18,2); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); site Site @relation(fields:[siteId], references:[id]); vendor Vendor @relation(fields:[vendorId], references:[id]); items POItem[]; grns GRN[]; invoices Invoice[]; }
model POItem { id String @id @default(cuid()); poId String; materialId String; orderedQty Decimal @db.Decimal(18,3); receivedQty Decimal @default(0) @db.Decimal(18,3); rate Decimal @db.Decimal(18,2); po PurchaseOrder @relation(fields:[poId], references:[id], onDelete:Cascade); material Material @relation(fields:[materialId], references:[id]); }
model GRN { id String @id @default(cuid()); companyId String; siteId String; poId String; number String @unique; receivedAt DateTime @default(now()); status Status @default(DRAFT); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); site Site @relation(fields:[siteId], references:[id]); po PurchaseOrder @relation(fields:[poId], references:[id]); items GRNItem[]; }
model GRNItem { id String @id @default(cuid()); grnId String; materialId String; receivedQty Decimal @db.Decimal(18,3); rejectedQty Decimal @default(0) @db.Decimal(18,3); grn GRN @relation(fields:[grnId], references:[id], onDelete:Cascade); material Material @relation(fields:[materialId], references:[id]); }
model Stock { id String @id @default(cuid()); siteId String; materialId String; quantity Decimal @default(0) @db.Decimal(18,3); site Site @relation(fields:[siteId], references:[id], onDelete:Cascade); material Material @relation(fields:[materialId], references:[id]); @@unique([siteId, materialId]) }
model Invoice { id String @id @default(cuid()); companyId String; vendorId String; poId String?; number String; invoiceDate DateTime; dueDate DateTime?; amount Decimal @db.Decimal(18,2); paidAmount Decimal @default(0) @db.Decimal(18,2); status Status @default(PENDING); company Company @relation(fields:[companyId], references:[id], onDelete:Cascade); vendor Vendor @relation(fields:[vendorId], references:[id]); po PurchaseOrder? @relation(fields:[poId], references:[id]); @@unique([vendorId, number]) }
